# Copy to .env before running `docker compose up`.
# docker compose reads .env from this directory automatically.

# ---------------------------------------------------------------- shared
ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------- postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# ---------------------------------------------------------------- jwt
# Must be IDENTICAL across every service - each one verifies tokens locally
# instead of calling the auth service. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------- admin bootstrap
# THIS IS HOW YOU BECOME ADMIN.
# On startup the auth service creates this user with role=admin if it does not
# already exist. Idempotent - safe on every restart. Leave both blank to skip.
# Signup (/auth/register) can NEVER create an admin; role is hardcoded there.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_NAME=Bootstrap Admin

# ---------------------------------------------------------------- auth
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900

# ---------------------------------------------------------------- catalog
PRODUCT_CACHE_TTL_SECONDS=300
LISTING_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------- consumers
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BACKOFF_MS=1000
OUTBOX_POLL_INTERVAL_MS=500

# ---------------------------------------------------------------- inventory
# How long stock is held for an unpaid order. Long enough for a payment to
# complete, short enough that a crashed saga does not strand stock for hours.
RESERVATION_TTL_MINUTES=15
SWEEPER_INTERVAL_SECONDS=60

# ---------------------------------------------------------------- payment
# Raise MOCK_FAILURE_RATE (0.0-1.0) to make random orders fail and demonstrate
# the compensation path without picking a specific test card. Deterministic per
# order_id, so a retry always reaches the same verdict as the first attempt.
#
# For a specific outcome, use a test token at checkout instead:
#   tok_test_success | tok_test_declined | tok_test_insufficient
#   tok_test_timeout | tok_test_expired
# See GET /payments/test-tokens.
MOCK_FAILURE_RATE=0.0
MOCK_LATENCY_MS=500

# ---------------------------------------------------------------- gateway
# Per-user when signed in, per-IP when anonymous. Writes get a tighter budget
# because they are cheaper to abuse and more expensive to serve.
RATE_LIMIT_REQUESTS=120
WRITE_RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
